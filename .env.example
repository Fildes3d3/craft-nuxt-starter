# =============================================================================
# Root .env — Docker Compose variables (database)
# `make setup` copies this to .env automatically.
# =============================================================================

MYSQL_ROOT_PASSWORD=root
DB_DATABASE=craft
DB_USER=craft
DB_PASSWORD=craft

# Host port for connecting to MySQL from your machine (e.g. TablePlus)
DB_FORWARD_PORT=13306

# Nuxt endpoints (passed into the nuxt container by docker-compose).
# These defaults are fine for local dev — uncomment to override.
#NUXT_PUBLIC_GQL_API_HOST=http://localhost/api
#NUXT_PUBLIC_CMS_ADMIN_URL=http://localhost/admin
#NUXT_GQL_API_HOST_SERVER=http://web/api
