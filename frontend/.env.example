# ⚠ Inside Docker these are overridden by the root .env (docker-compose
# passes them as process env, which beats this file). This file matters when
# running Nuxt directly on your host (npm run dev outside Docker).

# Browser-side GraphQL endpoint (public)
NUXT_PUBLIC_GQL_API_HOST=http://localhost/api

# Craft control-panel URL for editor-facing links
NUXT_PUBLIC_CMS_ADMIN_URL=http://localhost/admin

# Server-side (SSR) GraphQL endpoint — internal Docker network.
# NUXT_ prefix is required for private runtimeConfig overrides!
NUXT_GQL_API_HOST_SERVER=http://web/api
