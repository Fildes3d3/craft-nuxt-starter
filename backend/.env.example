# =============================================================================
# Craft CMS environment — `make setup` copies this to backend/.env
# =============================================================================

CRAFT_APP_ID=craft-nuxt-starter
CRAFT_ENVIRONMENT=dev

# `make setup` generates a real key automatically
CRAFT_SECURITY_KEY=

CRAFT_DEV_MODE=true
CRAFT_ALLOW_ADMIN_CHANGES=true
CRAFT_DISALLOW_ROBOTS=true

# Database — matches the docker-compose `db` service
DB_DRIVER=mysql
DB_SERVER=db
DB_PORT=3306
DB_DATABASE=craft
DB_USER=craft
DB_PASSWORD=craft
DB_SCHEMA=
DB_TABLE_PREFIX=

# URLs
PRIMARY_SITE_URL=http://localhost
UPLOADS_URL=http://localhost/uploads
